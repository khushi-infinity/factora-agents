# ───────────── Runtime data (N1+ generates real content) ─────────────
data/raw/*
data/generated/*
!data/raw/.gitkeep
!data/generated/.gitkeep
*.db
*.sqlite3

# ───────────── Logs / OS ─────────────
*.log
.DS_Store
Thumbs.db
