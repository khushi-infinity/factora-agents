# ───────────── Secrets ─────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p8
secrets.json

# ───────────── Dependencies ─────────────
node_modules/
.venv/

# ───────────── Builds / caches ─────────────
dist/
coverage/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
