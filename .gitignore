# ───────────── Secrets ─────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p8
secrets.json

# ───────────── Dependencies ─────────────
node_modules/
.venv/

# ───────────── Builds / caches ─────────────
dist/
coverage/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.tsbuildinfo

# ───────────── Runtime data (N1+ generates real content) ─────────────
data/raw/*
data/generated/*
!data/raw/.gitkeep
!data/generated/.gitkeep
*.db
*.sqlite3

# ───────────── Logs / OS ─────────────
*.log
.DS_Store
Thumbs.db

# ───────────── Local agent-hook config (`entire enable --agent`) ─────────────
# Per-developer hook wiring for coding agents. Not part of the submitted
# product: `.entire/settings.json` (tracked) is the shared Entire config, and
# `entire agent add <name>` regenerates these. `.github/hooks/` is ignored
# specifically so any future `.github/workflows/` CI stays committable.
.claude/
.codex/
.cursor/
.factory/
.gemini/
.pi/
.opencode/plugins/entire.ts
.github/hooks/
