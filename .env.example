# Factora — environment template (neatHack fresh repo)
#
# Copy to .env at the REPOSITORY ROOT and fill in with YOUR OWN values:
#     cp .env.example .env
#
# .env is gitignored and must NEVER be committed (AGENTS.md rule 5).
# This file contains placeholders only — no real keys or tokens.

# ───────────────────────── Backend ─────────────────────────
APP_ENV=development
API_PORT=8000

# ───────────────────── neatlogs (agent observability) ────────────────────
# Project API key from the neatlogs dashboard (Settings → API Keys).
# Required only for tracing: the app boots and runs normally without it
# (observability is reported as "disabled").
# Verified var name per docs.neatlogs.com (SDK Reference / Doctor pages).
NEATLOGS_API_KEY=
NEATLOGS_WORKFLOW_NAME=factora-agents
